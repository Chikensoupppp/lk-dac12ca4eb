<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE). Only keys that have no
     INFOPLIST_KEY_ build setting live here. -->
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_lockin-key._tcp</string>
		<string>_lockin-key._udp</string>
		<string>_nogbox._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.brandon132199.lockin.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nogbox</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Nogbox checks that your Key Holder's phone is right next to yours before they can end your session.</string>
</dict>
</plist>
