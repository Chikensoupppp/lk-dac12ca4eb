<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>nogbox.ico</ApplicationIcon>
    <AssemblyName>LockIn.Companion</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LockIn.Companion</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Watch/Assets/*.png" />
    <EmbeddedResource Include="../browser-extension/manifest.json" LogicalName="ext/manifest.json" />
    <EmbeddedResource Include="../browser-extension/background.js" LogicalName="ext/background.js" />
    <EmbeddedResource Include="../browser-extension/content.js" LogicalName="ext/content.js" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
