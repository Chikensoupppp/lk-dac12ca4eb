<Rive version="1" kind="fragment">
    <!--
        SwipeLater completion stamp. Riso red ink with a blue misregistration ghost, on newsprint E7E8E3.
        View model "Stamp": triggers `slam` (stamp lands) and `clear` (lifts off), strings `title` and `sub`.
        Text is Onest at weight 900 / 800, the same font the app already bundles.
        Rive paints the first sibling on top, so children read front to back.
    -->
