                    </StateTransition>
                </AnimationState>

                <AnimationState x="460" y="-80" animationId="0:161" id="0:191">
                    <StateTransition stateToId="0:190" duration="160">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:50-0:51" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="0"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="460" y="100" animationId="0:162" id="0:192">
                    <StateTransition stateToId="0:190" duration="160">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyNumber>
                                    <DataBindContext sourcePathIds="0:50-0:51" propertyKey="636"/>
                                </BindablePropertyNumber>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueNumberComparator value="0"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Empty: dashed ring only. Pins everything Done and Rest move, so going back to empty clears them. -->
        <LinearAnimation duration="60" loopValue="loop" name="Empty" id="0:160">
            <KeyedObject objectId="0:130">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="1" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="1" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="15"><KeyFrameDouble value="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:131"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:132"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:133"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:134"><KeyedProperty propertyKey="18"><KeyFrameDouble value="1" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:181"><KeyedProperty propertyKey="115"><KeyFrameDouble value="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- Done: pops in with a little overshoot and tilt, then the check draws on. -->
        <LinearAnimation duration="40" loopValue="oneShot" name="Done" id="0:161">
            <KeyedObject objectId="0:130">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.4" interpolationType="cubic"><CubicEaseInterpolator x1="0.23" y1="1" x2="0.32" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.16" frame="8" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.96" frame="15" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="24" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.4" interpolationType="cubic"><CubicEaseInterpolator x1="0.23" y1="1" x2="0.32" y2="1"/></KeyFrameDouble>
