<Rive version="1" kind="fragment">
    <!--
        SwipeLater streak row: five day stickers, riso palette on newsprint E7E8E3.
        Artboard "Week" (default) places five stateful "Sticker" components. View model "Week" has numbers
        day1..day5: 0 = empty (dashed ring), 1 = finished (sunflower disc, ink check draws on), 2 = rest day
        (riso blue disc, pause bars). The app sets them one after another about 120ms apart for the ripple.
        Day labels and the count-up number stay in SwiftUI.
        Rive paints the first sibling on top, so children read front to back.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:40" viewModelInstanceId="0:46" width="400" height="80" name="Week" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <NestedArtboard artboardId="0:30" isStateful="true" x="0" y="0" name="Day 1" id="0:10">
            <ViewModelInstance viewModelId="0:50" exports="true" name="Day 1 Instance" id="0:70">
                <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:51" name="Kind">
                    <DataBindContext sourcePathIds="0:40-0:41" propertyKey="575"/>
                </ViewModelInstanceNumber>
            </ViewModelInstance>
            <NestedStateMachine animationId="0:81" name="Sticker SM"/>
        </NestedArtboard>
        <NestedArtboard artboardId="0:30" isStateful="true" x="80" y="0" name="Day 2" id="0:11">
            <ViewModelInstance viewModelId="0:50" exports="true" name="Day 2 Instance" id="0:71">
                <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:51" name="Kind">
                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="575"/>
                </ViewModelInstanceNumber>
            </ViewModelInstance>
            <NestedStateMachine animationId="0:81" name="Sticker SM"/>
        </NestedArtboard>
        <NestedArtboard artboardId="0:30" isStateful="true" x="160" y="0" name="Day 3" id="0:12">
            <ViewModelInstance viewModelId="0:50" exports="true" name="Day 3 Instance" id="0:72">
                <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:51" name="Kind">
                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="575"/>
                </ViewModelInstanceNumber>
            </ViewModelInstance>
            <NestedStateMachine animationId="0:81" name="Sticker SM"/>
        </NestedArtboard>
        <NestedArtboard artboardId="0:30" isStateful="true" x="240" y="0" name="Day 4" id="0:13">
            <ViewModelInstance viewModelId="0:50" exports="true" name="Day 4 Instance" id="0:73">
                <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:51" name="Kind">
                    <DataBindContext sourcePathIds="0:40-0:44" propertyKey="575"/>
                </ViewModelInstanceNumber>
            </ViewModelInstance>
            <NestedStateMachine animationId="0:81" name="Sticker SM"/>
        </NestedArtboard>
        <NestedArtboard artboardId="0:30" isStateful="true" x="320" y="0" name="Day 5" id="0:14">
            <ViewModelInstance viewModelId="0:50" exports="true" name="Day 5 Instance" id="0:74">
                <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:51" name="Kind">
                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="575"/>
                </ViewModelInstanceNumber>
            </ViewModelInstance>
            <NestedStateMachine animationId="0:81" name="Sticker SM"/>
        </NestedArtboard>

        <StateMachine name="Week" id="0:7">
            <StateMachineLayer name="Main" id="0:8"><AnyState x="0" y="-100"/><ExitState x="400" y="-100"/><EntryState x="0" y="0"/></StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard isComponent="true" x="0" y="140" defaultStateMachineId="0:81" styleId="0:129" viewModelId="0:50" viewModelInstanceId="0:52" width="80" height="80" name="Sticker" id="0:30">
        <LayoutComponentStyle name="Artboard Style" id="0:129"/>

        <Node x="40" y="40" name="Body" id="0:130">
            <Node name="Done" id="0:131">
                <Shape name="Check">
                    <PointsPath name="Path">
                        <StraightVertex x="-12" y="1"/>
                        <StraightVertex x="-3" y="11"/>
                        <StraightVertex x="14" y="-10"/>
                    </PointsPath>
                    <Stroke thickness="7" cap="round" join="round" name="Line">
                        <SolidColor colorValue="FF1B1B1B" name="Color"/>
                        <TargetEffect targetId="0:180" name="Use Trim"/>
                    </Stroke>
                </Shape>
                <Shape name="Disc">
                    <Ellipse width="56" height="56" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFB511" name="Color"/></Fill>
                    <Stroke thickness="4" name="Outline"><SolidColor colorValue="FF1B1B1B" name="Color"/></Stroke>
                </Shape>
            </Node>
            <Node opacity="0" name="Rest" id="0:132">
                <Shape x="-8" name="Bar L">
                    <Rectangle width="7" height="22" cornerRadiusTL="3" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFE7E8E3" name="Color"/></Fill>
                </Shape>
                <Shape x="8" name="Bar R">
                    <Rectangle width="7" height="22" cornerRadiusTL="3" name="Path"/>
