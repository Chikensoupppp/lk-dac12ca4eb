                <EntryState>
                    <StateTransition stateToId="0:190"/>
                </EntryState>

                <AnimationState x="200" y="0" animationId="0:160" id="0:190">
                    <StateTransition stateToId="0:191" duration="0">
                        <TransitionViewModelCondition>
