            <KeyedObject objectId="0:181">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="6" interpolationType="cubic"><CubicEaseInterpolator x1="0.23" y1="1" x2="0.32" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="20" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Rest: the same pop, a notch softer, with pause bars instead of a check. -->
        <LinearAnimation duration="40" loopValue="oneShot" name="Rest" id="0:162">
            <KeyedObject objectId="0:130">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.5" interpolationType="cubic"><CubicEaseInterpolator x1="0.23" y1="1" x2="0.32" y2="1"/></KeyFrameDouble>
