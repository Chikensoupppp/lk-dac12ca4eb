                </Shape>
                <Shape name="Disc">
                    <Ellipse width="56" height="56" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF3255A4" name="Color"/></Fill>
                    <Stroke thickness="4" name="Outline"><SolidColor colorValue="FF1B1B1B" name="Color"/></Stroke>
                </Shape>
            </Node>
            <Shape x="3" y="4" opacity="0" name="Ink Shadow" id="0:133">
                <Ellipse width="56" height="56" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF1B1B1B" name="Color"/></Fill>
            </Shape>
        </Node>

        <Node x="40" y="40" name="Empty" id="0:134">
            <Shape name="Ring">
                <Ellipse width="54" height="54" name="Path"/>
                <Stroke thickness="3" cap="round" name="Line">
