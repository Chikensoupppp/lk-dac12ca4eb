<Rive version="1" kind="fragment">
    <!--
        SwipeLater "session done" screen, one full-screen scene (390 x 844 pt, iPhone 15 frame).
        Idea: the ring closes. The amber arc from the Focus dial finishes its lap, snaps shut around the
        brain and throws a spark burst; the time lands; today's day fills in and sends a spark up into
        the streak counter, which rolls over. Palette is the Focus screen's (DESIGN.md): paper F6F3EC,
        ink 171513, soft 6F6A60, hairline E4DED3, amber A97029, plus the brain's pink.
        Borrowed from: Apple Fitness (closing ring + burst), Duolingo (rolling streak number, today lights
        up, built in Rive), Headspace (one calm hero on a warm ground, little text).
        View model "Complete": strings focused, task, streakFrom, streakTo.
        "Footer (preview)" draws the buttons for renders only; the app draws real SwiftUI buttons there.
        Rive paints the first sibling on top, so children read front to back.
    -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:40" viewModelInstanceId="0:49" width="390" height="844" name="Complete" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- ===== Footer: preview only. The app sets `footer` to 0 and draws real SwiftUI buttons here. ===== -->
        <Node name="Footer Gate" id="0:191">
            <DataBindContext sourcePathIds="0:40-0:203" propertyKey="18"/>
        <Node opacity="0" name="Footer (preview)" id="0:190">
