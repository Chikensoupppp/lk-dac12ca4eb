        <StateMachine name="Brain" id="1:7">
            <StateMachineLayer name="Main" id="1:8">
                <!-- A fired `win` cheers from anywhere, even from sleepy. -->
                <AnyState x="200" y="-160">
                    <StateTransition stateToId="1:51" duration="120">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
